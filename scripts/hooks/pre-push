#!/bin/sh
# Lightweight SDD: refuse any push that creates, updates, or deletes the default branch.
# Enable once per clone: git config core.hooksPath scripts/hooks
# The default branch is this repository's git config sdd.defaultBranch, else <remote>/HEAD.
# A declaration is checked against origin as scripts/sdd/changes.py does; an unknown,
# missing, unreadable, or contradictory value fails closed.
# Bypassing with --no-verify is a human decision recorded in the PR, never an agent's.
remote="$1"

refuse() {
    echo "pre-push: $*" >&2
    exit 1
}

is_remote() {
    git config --get "remote.$1.url" >/dev/null 2>&1
}

# Print the branch <name>/HEAD points to, or nothing; a push to a URL has no such ref.
remote_head() {
    is_remote "$1" || return 0
    ref=$(git symbolic-ref -q "refs/remotes/$1/HEAD")
    code=$?
    [ "$code" -le 1 ] || refuse "cannot read $1/HEAD (git exited $code)"
    case "$ref" in
        "refs/remotes/$1/"?*) printf '%s\n' "${ref#"refs/remotes/$1/"}" ;;
    esac
}

origin_head=$(remote_head origin) || exit 1
push_head=$(remote_head "$remote") || exit 1

default=$(git config --local --get sdd.defaultBranch)
code=$?
[ "$code" -le 1 ] || refuse "cannot read sdd.defaultBranch (git config exited $code)"
if [ -n "$default" ]; then
    git show-ref --verify -q "refs/heads/$default" ||
        git show-ref --verify -q "refs/remotes/origin/$default" ||
        refuse "sdd.defaultBranch '$default' names no local or origin branch; fix the declaration"
    [ -z "$origin_head" ] || [ "$origin_head" = "$default" ] ||
        refuse "sdd.defaultBranch '$default' disagrees with origin/HEAD '$origin_head'; fix one of them"
else
    default=$push_head
fi
if [ -z "$default" ]; then
    if is_remote "$remote"; then
        refuse "cannot determine the default branch; run 'git remote set-head $remote --auto'" \
               "or 'git config sdd.defaultBranch <name>'"
    fi
    refuse "cannot determine the default branch for a push to a URL; run 'git config sdd.defaultBranch <name>'"
fi

status=0
while read -r local_ref local_oid remote_ref remote_oid; do
    if [ "$remote_ref" = "refs/heads/$default" ]; then
        echo "pre-push: refusing to update the default branch '$default'; push a change branch" \
             "and open a pull request" >&2
        status=1
    fi
done
exit $status
