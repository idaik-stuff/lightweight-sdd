{
  "version": 1,
  "rules": [
    {
      "id": "public-contract",
      "minimum_level": "L3",
      "paths": [
        "api/public/**",
        "contracts/public/**",
        "**/openapi*.json",
        "**/openapi*.yaml",
        "**/openapi*.yml",
        "**/*.proto"
      ],
      "reason": "Potential external contract; inspect consumers and compatibility."
    },
    {
      "id": "security-boundary",
      "minimum_level": "L3",
      "paths": [
        "**/auth/**",
        "**/authorization/**",
        "**/permissions/**",
        "security/**"
      ],
      "reason": "Potential access-control or security-boundary change."
    },
    {
      "id": "persistent-data",
      "minimum_level": "L3",
      "paths": [
        "**/migrations/**"
      ],
      "reason": "Conservative migration floor; establish data impact and recovery."
    },
    {
      "id": "production-delivery",
      "minimum_level": "L3",
      "paths": [
        "deploy/**",
        "ops/**"
      ],
      "reason": "Deployment definitions and operations scripts; affects exposure, secrets, data, and recovery."
    }
  ]
}
