{
  "version": 1,
  "rules": [
    {
      "id": "delivery-policy",
      "minimum_level": "L3",
      "paths": [
        ".github/workflows/**",
        ".claude/settings*.json"
      ],
      "reason": "Changes delivery or agent permission controls."
    },
    {
      "id": "verification-controls",
      "minimum_level": "L3",
      "paths": [
        ".sdd/verification.json",
        ".sdd/risk-rules.json",
        ".sdd/product-risk-rules.json",
        "scripts/verify",
        "scripts/check-docs",
        "scripts/check-change-level",
        "scripts/sdd/**",
        "scripts/hooks/**"
      ],
      "reason": "Changes the commands or policy used to produce verification evidence."
    },
    {
      "id": "ci-governance",
      "minimum_level": "L3",
      "paths": [
        ".github/**",
        ".sdd/ci.json",
        "scripts/check-ci",
        "scripts/check-ci-setup",
        "AGENTS.md",
        "CLAUDE.md",
        ".agents/adapters/**",
        ".agents/tools/**"
      ],
      "reason": "Changes workflow trust, ownership, or CI enforcement; require independent review."
    },
    {
      "id": "agent-integration-controls",
      "minimum_level": "L3",
      "paths": [
        ".agents/workflows/**",
        ".agents/skills/**",
        ".agents/review/**",
        ".claude/skills/**",
        ".claude/agents/**",
        ".cursor/**",
        ".codex/**"
      ],
      "reason": "Changes discoverable procedures, invocation gates, or reviewer capabilities; inspect every supported client."
    }
  ]
}
